let fib_tailrec: int -> int, int =
  1 1 fib_tailrec_helper;;

let fib_tailrec_helper: int, int, int -> int, int =
  -> n, a, b;
  n
  if (n = 0)   a
  elif (n = 1) b
  else           (n - 1) b (a + b) fib_tailrec_helper
  ;;

let fib_body =
  -> n, a, b;
  n (n - 1) b (a + b) 
  ;;

