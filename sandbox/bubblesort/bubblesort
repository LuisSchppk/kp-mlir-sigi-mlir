let gt_zero: int-> int, bool = 
    dup
    > 0;;

let decr_and_check: int-> int, bool = 
    -> size;
    (size -1) (size > 0);;

let print_stack_and_pop: 'a, int -> int=
    {decr_and_check} {show_second} while;;

let walk: ('a ->) -> int -> int =
    -> \f, n;
    {decr_and_check} {
         -> x, n;
         f apply;
         n
    } while;;



